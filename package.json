{
  "name": "teamree",
  "version": "0.1.0",
  "description": "An ADE built for teamwork",
  "author": "teamree contributors",
  "homepage": "https://github.com/zero-abd/teamree",
  "desktopName": "teamree.desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "pretest": "node scripts/require-test-environment.mjs",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt -c=.oxfmtrc.json .",
    "smoke": "npm run build && node scripts/run-smoke.mjs",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "test:watch": "vitest",
    "build:cli": "node scripts/build-cli.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:verify": "node scripts/verify-package.mjs",
    "install:verify": "node scripts/verify-quarantine-advice.mjs",
    "format:check": "oxfmt --check -c=.oxfmtrc.json ."
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.5.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  },
  "bin": {
    "teamree": "./out/cli/index.js"
  }
}
