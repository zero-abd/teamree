{
  "name": "teamree-relay",
  "version": "0.1.0",
  "description": "A dumb pipe that splices two outbound WebSocket connections together",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/node/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/node/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.workers.json",
    "deploy": "node bin/teamree-relay.mjs deploy --here",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.131.1"
  }
}
