/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The images are NOT content-hashed -- og.png is always og.png -- so they are
# overwritten in place on every deploy. A long max-age would pin a visitor to
# stale bytes with no way to bust it short of renaming the file, and the mark is
# actively being redrawn. Five minutes, then serve-stale-while-revalidating:
# a correction is universally live within five minutes and costs no latency,
# because every asset already carries a strong etag and revalidating is a 304.
# `immutable` would be wrong here for exactly the same reason.
/screenshot.png
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/icon-256.png
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# The download aliases resolve to whatever GitHub calls "latest". Caching that
# redirect would pin the destination to the release that happened to be current
# when it was cached, which is the one thing it must never do. Two blocks,
# because Pages globbing means /download/* does not match /download itself.
/download
  Cache-Control: no-store

/download/*
  Cache-Control: no-store
